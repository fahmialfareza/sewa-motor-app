APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://sewa_motor:sewa_motor@localhost:5432/sewa_motor?sslmode=disable
REDIS_URL=redis://localhost:6379/0
AUTO_MIGRATE=false
LOG_LEVEL=info
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=sewa-motor-backend
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
NEW_RELIC_LOG_FORWARDING_ENABLED=true
SHUTDOWN_TIMEOUT=10s
SESSION_CACHE_TTL=15m
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=1m
TRUSTED_PROXIES=
DEV_SUPERADMIN_FULL_NAME="Penyok"
DEV_SUPERADMIN_USERNAME=superadmin
# Optional. Leave blank to use the development-only fallback: superadmin123
DEV_SUPERADMIN_PASSWORD=
