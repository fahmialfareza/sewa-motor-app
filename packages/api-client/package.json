{
  "name": "@sewa-motor/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/generated/schema.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "generate": "openapi-typescript ../../api/openapi.yaml --output src/generated/schema.ts",
    "generate:check": "node scripts/check-generated.mjs",
    "lint": "eslint src scripts --max-warnings 0"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.0"
  },
  "devDependencies": {
    "@sewa-motor/eslint-config": "workspace:*",
    "@sewa-motor/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "openapi-typescript": "^7.9.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
